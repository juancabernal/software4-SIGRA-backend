# Plantilla de configuración local de SIGRA (compartida por el equipo).
# Copia este archivo a ".env" dentro de la carpeta SIGRA/ y completa los valores.
# El archivo ".env" real está ignorado por Git y NUNCA debe subirse al repositorio.
#
# Las variables reales del sistema (por ejemplo $env:DB_URL en PowerShell) tienen
# prioridad sobre este archivo.
#
# BASE DE DATOS
#   - postgres es la DATABASE (la base de datos de PostgreSQL).
#   - sigra es un SCHEMA dentro de esa base, NO una base de datos.
#     Por eso la URL termina en "?currentSchema=sigra".
#   - El PUERTO depende de cada máquina: 5432 es el valor por defecto de PostgreSQL,
#     pero cada desarrollador puede tener otro (por ejemplo 5433). Cambia solo el puerto
#     de DB_URL en tu .env; el puerto NO se fija en el código.
#   - Usuario y contraseña: los de tu propio servidor local. No los compartas.

DB_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=sigra
DB_USERNAME=postgres
DB_PASSWORD=cambiar_esta_clave

SERVER_PORT=8080

# JWT_SECRET: mínimo 32 bytes. Genera un valor propio y NO lo reutilices en otros entornos.
JWT_SECRET=cambiar_por_un_secreto_de_al_menos_32_bytes
JWT_EXPIRATION_MS=3600000

CORS_ALLOWED_ORIGINS=http://localhost:4200

# validate: Hibernate solo valida que las entidades coincidan con el esquema SQL.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
