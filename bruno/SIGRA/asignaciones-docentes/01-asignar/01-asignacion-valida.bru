meta {
  name: 01-asignacion-valida
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/asignaciones-docentes
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "profesorIds": ["{{idProfesorPrueba}}"],
    "asignaturaIds": ["{{idAsigBruEstActiva}}"]
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.body.creadas.length > 0) {
    bru.setVar("idAsignacionDocente", res.body.creadas[0].id);
  }
}
