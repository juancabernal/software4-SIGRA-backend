meta {
  name: 08 Tercer intento fallido
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correoInstitucional": "{{authCorreoBloqueo}}",
    "contrasena": "{{authPasswordIncorrecto}}"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("intento 3 rechazado", function () {
    expect(res.body.mensaje).to.equal("Correo o contraseña incorrectos");
  });
}
