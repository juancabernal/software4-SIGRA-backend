meta {
  name: 02 Password incorrecta
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correoInstitucional": "{{authCorreoNormal}}",
    "contrasena": "{{authPasswordIncorrecto}}"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("mensaje seguro sin detalles tecnicos", function () {
    expect(res.body.mensaje).to.equal("Correo o contraseña incorrectos");
    expect(res.body.error).to.equal("UNAUTHORIZED");
    expect(res.body).to.have.property("timestamp");
    const raw = JSON.stringify(res.body);
    expect(raw).to.not.include("Exception");
    expect(raw).to.not.include("at co.edu");
  });
}
