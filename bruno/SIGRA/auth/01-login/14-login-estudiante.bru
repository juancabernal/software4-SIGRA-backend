meta {
  name: 14 Login estudiante
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correoInstitucional": "{{authCorreoEstudiante}}",
    "contrasena": "{{authPasswordCorrecto}}"
  }
}

assert {
  res.status: eq 200
  res.body.tipo: eq Bearer
  res.body.usuario.rol: eq ESTUDIANTE
}

tests {
  test("token emitido no esta vacio", function () {
    expect(res.body.token).to.be.a('string');
    expect(res.body.token.length).to.be.greaterThan(20);
  });

  test("usuario coincide con credenciales", function () {
    expect(res.body.usuario.correoInstitucional).to.equal(bru.getEnvVar("authCorreoEstudiante"));
    expect(res.body.usuario).to.not.have.property("passwordHash");
  });
}
