meta {
  name: 03 Correo inexistente
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correoInstitucional": "usuario.inexistente999@uco.net.co",
    "contrasena": "{{authPasswordCorrecto}}"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("mensaje identico al de password incorrecta para evitar enumeracion", function () {
    expect(res.body.mensaje).to.equal("Correo o contraseña incorrectos");
    expect(res.body.error).to.equal("UNAUTHORIZED");
    expect(res.body).to.have.property("timestamp");
    const raw = JSON.stringify(res.body);
    expect(raw).to.not.include("Exception");
  });
}
