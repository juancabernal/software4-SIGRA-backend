meta {
  name: 05 Password vacio
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correoInstitucional": "{{authCorreoNormal}}",
    "contrasena": ""
  }
}

assert {
  res.status: eq 400
}

tests {
  test("valida presencia de contrasena", function () {
    expect(res.body.error).to.equal("BAD_REQUEST");
    expect(res.body).to.have.property("detalles");
  });
}
