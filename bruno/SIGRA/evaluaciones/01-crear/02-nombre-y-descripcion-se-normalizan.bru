meta {
  name: 02 Nombre y descripcion se normalizan (30%)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/resultados-aprendizaje/{{evaRaAct01Id}}/evaluaciones
  body: json
  auth: none
}

body:json {
  {
    "nombre": "  Taller   1  ",
    "fechaTentativa": "{{fechaManana}}",
    "porcentaje": 30,
    "descripcion": "  Taller   en\\n grupo  "
  }
}

assert {
  res.status: eq 201
  res.body.nombre: eq Taller 1
}

script:post-response {
  bru.setVar("evaTallerId", res.body.id);
}

tests {
  test("la descripcion queda con un solo espacio y sin bordes", function () {
    expect(res.body.descripcion).to.equal("Taller en grupo");
  });
}
