meta {
  name: 15 Nombre con etiqueta script
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/resultados-aprendizaje/{{evaRaAct02Id}}/evaluaciones
  body: json
  auth: none
}

body:json {
  {
    "nombre": "<script>alert(1)</script>",
    "fechaTentativa": "{{fechaHoy}}",
    "porcentaje": 10,
    "descripcion": "Evaluacion de prueba del resultado de aprendizaje"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("el detalle senala el campo nombre", function () {
    expect(res.body.detalles.some(function (d) { return d.startsWith("nombre:"); })).to.equal(true);
  });

  test("el error no repite el valor enviado", function () {
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("<script>");
    expect(texto).to.not.include("alert(1)");
  });

  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body).to.have.property("timestamp");
    expect(res.body).to.have.property("status");
    expect(res.body).to.have.property("error");
    expect(res.body).to.have.property("mensaje");
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
