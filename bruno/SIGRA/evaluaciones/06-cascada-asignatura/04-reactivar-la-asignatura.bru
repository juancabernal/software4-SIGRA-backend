meta {
  name: 04 Reactivar la asignatura EVA-CAS (administrador)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/asignaturas/{{evaAsigCasId}}/activar
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenAdmin}}
}

assert {
  res.status: eq 200
  res.body.estado: eq ACTIVA
  res.body.cantidadRa: eq 5
}
