meta {
  name: 01 Login profesor
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correoInstitucional": "{{authCorreoNormal}}",
    "contrasena": "{{authPasswordCorrecto}}"
  }
}

script:pre-request {
  req.deleteHeader("Authorization");
}

assert {
  res.status: eq 200
  res.body.usuario.rol: eq PROFESOR
}

script:post-response {
  bru.setVar("tokenProfesor", res.body.token);
  const d = new Date();
  const p = function (n) { return String(n).padStart(2, "0"); };
  bru.setVar("fechaHoy", d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate()));
}

tests {
  test("entrega un token", function () {
    expect(res.body.token).to.be.a("string").and.not.be.empty;
  });
}
