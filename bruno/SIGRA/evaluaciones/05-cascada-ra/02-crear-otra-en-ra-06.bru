meta {
  name: 02 Crear otra evaluacion en RA-06 (20%)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/resultados-aprendizaje/{{evaRaAct06Id}}/evaluaciones
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Taller RA6",
    "fechaTentativa": "{{fechaHoy}}",
    "porcentaje": 20,
    "descripcion": "Evaluacion de prueba del resultado de aprendizaje"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("evaRa6TallerId", res.body.id);
}
