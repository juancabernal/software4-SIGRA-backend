meta {
  name: 04 Ruta privada sin token devuelve 401
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/programas
  body: none
  auth: none
}

assert {
  res.status: eq 401
  res.body.error: eq UNAUTHORIZED
}

tests {
  test("respuesta de seguridad sin detalles técnicos", function () {
    expect(res.body).to.have.property("timestamp");
    expect(res.body).to.have.property("mensaje");
    expect(JSON.stringify(res.body)).to.not.include("Exception");
  });
}
