meta {
  name: 02 Login profesor
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correoInstitucional": "{{authCorreoNormal}}",
    "contrasena": "{{authPasswordCorrecto}}"
  }
}

assert {
  res.status: eq 200
  res.body.usuario.rol: eq PROFESOR
}

script:post-response {
  bru.setVar("tokenProfesor", res.body.token);
}
