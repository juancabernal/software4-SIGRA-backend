meta {
  name: 01 Matricular para la prueba sin confirmar
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/matriculas
  body: json
  auth: none
}

body:json {
  {
    "estudianteId": "{{idEstudianteConfirmacion}}",
    "asignaturaId": "{{idAsigBruEstActiva}}",
    "semestreId": "{{idSemBruEstActivo}}"
  }
}

script:post-response {
  bru.setVar("matriculaConfirmacionSinConfirmarId", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("matricula creada para el caso de confirmacion", function () {
    expect(res.body.id).to.be.a("string").and.not.be.empty;
    expect(res.body.estado).to.equal("ACTIVA");
  });
}
