meta {
  name: 02 Intentar cambiar el documento
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/estudiantes/{{idEstudianteModificar}}
  body: json
  auth: none
}

body:json {
  {
    "tipoDocumentoId": "{{tipoDocCc}}",
    "numeroDocumento": "9999999999",
    "nombreCompleto": "Bruno Modificar Actualizado",
    "correoInstitucional": "bruno.modificar.nuevo@uco.net.co"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("mensaje esperado", function () {
    expect(res.body.mensaje).to.include("El tipo y el número de documento del estudiante no se pueden modificar después del registro");
  });

  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body).to.have.property("timestamp");
    expect(res.body).to.have.property("status");
    expect(res.body).to.have.property("error");
    expect(res.body).to.have.property("mensaje");
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
