meta {
  name: 06 Asignaturas de un estudiante
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/estudiantes/{{idEstudianteMatriculaValida}}/asignaturas
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("lista las asignaturas en las que el estudiante esta o estuvo matriculado", function () {
    expect(res.body).to.be.an("array");
    const semestres = res.body.map(a => a.semestreCodigo);
    expect(semestres).to.include.members(["BRUEST-A1", "BRUEST-A2"]);
    res.body.forEach((a) => expect(a.asignaturaNombre).to.equal("Bruno Estudiantes Activa"));
  });

  test("cada entrada trae la fecha de su matricula y un estado valido", function () {
    res.body.forEach((a) => {
      expect(a.fechaMatricula).to.match(/^\d{4}-\d{2}-\d{2}$/);
      expect(["ACTIVA", "DESVINCULADA"]).to.include(a.estado);
    });
  });
}
