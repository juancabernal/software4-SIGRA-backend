meta {
  name: 05 Semestre no activo
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/matriculas
  body: json
  auth: none
}

body:json {
  {
    "estudianteId": "{{idEstudianteMatriculaValida}}",
    "asignaturaId": "{{idAsigBruEstActiva}}",
    "semestreId": "{{idSemBruEstInactivo}}"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("mensaje esperado", function () {
    // El mensaje cambio de "no esta activo" a "no esta vigente": la vigencia ahora se juzga
    // por las fechas del semestre (fecha_fin ya paso), no por su marca de estado almacenada
    // (design.md D3). BRUEST-IN sigue sirviendo para este caso porque sus fechas (1980) ya
    // pasaron, sin importar que su estado guardado diga ACTIVO/INACTIVO.
    expect(res.body.mensaje).to.include("El semestre con id " + bru.getEnvVar("idSemBruEstInactivo") + " no está vigente");
  });

  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body).to.have.property("timestamp");
    expect(res.body).to.have.property("status");
    expect(res.body).to.have.property("error");
    expect(res.body).to.have.property("mensaje");
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
