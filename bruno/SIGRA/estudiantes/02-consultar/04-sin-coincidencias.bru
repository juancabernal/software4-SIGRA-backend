meta {
  name: 04 Sin coincidencias
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/estudiantes?filtro=zzzxxqqnoexiste
  body: none
  auth: none
}

params:query {
  filtro: zzzxxqqnoexiste
}

assert {
  res.status: eq 200
}

tests {
  test("responde un arreglo vacio", function () {
    expect(res.body).to.be.an("array");
    expect(res.body).to.have.lengthOf(0);
  });
}
