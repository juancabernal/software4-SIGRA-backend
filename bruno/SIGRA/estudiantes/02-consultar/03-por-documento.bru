meta {
  name: 03 Por documento
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/estudiantes?filtro=1000000002
  body: none
  auth: none
}

params:query {
  filtro: 1000000002
}

assert {
  res.status: eq 200
}

tests {
  test("encuentra el estudiante por su numero de documento", function () {
    expect(res.body).to.be.an("array").with.lengthOf(1);
    expect(res.body[0].numeroDocumento).to.equal("1000000002");
    expect(res.body[0].id).to.equal(bru.getEnvVar("idEstudianteConsulta"));
  });
}
