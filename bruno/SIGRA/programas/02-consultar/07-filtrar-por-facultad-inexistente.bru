meta {
  name: 07 Filtrar por facultad inexistente
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/programas?facultadId={{idFacultadInexistente}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("devuelve lista vacia", function () {
    expect(res.body).to.be.an("array").that.is.empty;
  });
}
