meta {
  name: 06 Sin facultad
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/programas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Programa Bruno Sin Facultad {{sufijoSinFacultad}}",
    "codigo": "BRG{{sufijoSinFacultad}}"
  }
}

script:pre-request {
  bru.setVar("sufijoSinFacultad", String(Date.now()).slice(-7));
}

assert {
  res.status: eq 400
}

tests {
  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body).to.have.property("detalles");
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
