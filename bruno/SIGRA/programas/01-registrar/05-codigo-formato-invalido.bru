meta {
  name: 05 Codigo formato invalido
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/programas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Programa Bruno Codigo Invalido {{sufijoNombre}}",
    "codigo": "BRU 001"
  }
}

script:pre-request {
  bru.setVar("sufijoNombre", String(Date.now()).slice(-7));
}

assert {
  res.status: eq 400
}

tests {
  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body).to.have.property("detalles");
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
