meta {
  name: 07 Facultad inexistente
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/programas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Programa Bruno Facultad Inexistente {{sufijoFacInex}}",
    "codigo": "BRH{{sufijoFacInex}}",
    "facultadId": "{{idFacultadInexistente}}"
  }
}

script:pre-request {
  bru.setVar("sufijoFacInex", String(Date.now()).slice(-7));
}

assert {
  res.status: eq 404
}

tests {
  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body.mensaje).to.include(bru.getEnvVar("idFacultadInexistente"));
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
