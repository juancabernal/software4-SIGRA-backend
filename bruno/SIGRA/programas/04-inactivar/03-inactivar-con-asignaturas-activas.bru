meta {
  name: 03 Inactivar con asignaturas activas
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/programas/{{programaActivoId}}/inactivar
  body: none
  auth: none
}

assert {
  res.status: eq 409
}

tests {
  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body.mensaje).to.include("asignaturas activas");
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
