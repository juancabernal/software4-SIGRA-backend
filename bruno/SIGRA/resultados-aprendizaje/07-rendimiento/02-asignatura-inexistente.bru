meta {
  name: 02 Asignatura inexistente
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/asignaturas/{{raIdInexistente}}/resultados-aprendizaje/rendimiento
  body: none
  auth: none
}

assert {
  res.status: eq 404
}

tests {
  test("mensaje esperado", function () {
    expect(res.body.mensaje).to.include("No existe una asignatura con id");
  });
}
