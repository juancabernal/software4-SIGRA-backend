meta {
  name: 04 Preparar - recalcular el nivel de logro (seed-nivel-logro.sql)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/resultados-aprendizaje/{{raNivConNotasId}}/semestres/{{semBruNivId}}/estadisticas/recalculo
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  Requiere haber ejecutado bruno/SIGRA/seed/seed-nivel-logro.sql. El rendimiento lee las filas de
  nivel_logro_estudiante, que el recalculo (manual o el programado cada 5 minutos) deja al dia.
}
