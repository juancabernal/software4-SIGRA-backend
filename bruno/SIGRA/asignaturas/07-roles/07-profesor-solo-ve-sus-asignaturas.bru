meta {
  name: 07 Profesor solo ve sus asignaturas
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/asignaturas
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenProfesor}}
}

assert {
  res.status: eq 200
}

tests {
  test("solo BRU10 y BRU07", function () {
    const codigos = res.body.map((a) => a.codigo).sort();
    expect(codigos).to.eql(["BRU07", "BRU10"]);
    expect(codigos).to.not.include("BRU05");
  });
}
