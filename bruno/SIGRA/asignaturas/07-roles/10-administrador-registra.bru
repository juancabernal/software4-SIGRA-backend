meta {
  name: 10 Administrador registra
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/asignaturas
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{tokenAdmin}}
}

body:json {
  {
    "codigo": "{{codigoRolAdmin}}",
    "nombre": "Registrada por el administrador",
    "programaId": "{{programaActivoId}}"
  }
}

script:pre-request {
  // Solo corre con el control por rol encendido (backend y variable controlPorRol=true).
  if (String(bru.getEnvVar("controlPorRol")) !== "true") {
    bru.runner.skipRequest();
  }
  bru.setVar("codigoRolAdmin", "BRUROL" + Date.now());
}

assert {
  res.status: eq 201
  res.body.estado: eq BORRADOR
}
