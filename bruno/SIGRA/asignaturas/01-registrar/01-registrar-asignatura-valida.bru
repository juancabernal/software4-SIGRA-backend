meta {
  name: 01 Registrar asignatura valida
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/asignaturas
  body: json
  auth: none
}

body:json {
  {
    "codigo": "{{codigoNuevo}}",
    "nombre": "Asignatura de prueba",
    "programaId": "{{programaActivoId}}"
  }
}

script:pre-request {
  bru.setVar("codigoNuevo", "bru" + Date.now());
}

assert {
  res.status: eq 201
  res.body.estado: eq BORRADOR
  res.body.cantidadRa: eq 0
  res.body.programaId: eq {{programaActivoId}}
}

script:post-response {
  bru.setVar("asignaturaCreadaId", res.body.id);
}

tests {
  test("codigo queda en mayusculas", function () {
    expect(res.body.codigo).to.equal(bru.getVar("codigoNuevo").toUpperCase());
  });

  test("devuelve el id generado", function () {
    expect(res.body.id).to.be.a("string").and.not.be.empty;
  });
}
