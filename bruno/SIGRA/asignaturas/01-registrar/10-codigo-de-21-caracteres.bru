meta {
  name: 10 Codigo de 21 caracteres
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/asignaturas
  body: json
  auth: none
}

body:json {
  {
    "codigo": "{{codigoLargo}}",
    "nombre": "Codigo largo",
    "programaId": "{{programaActivoId}}"
  }
}

script:pre-request {
  bru.setVar("codigoLargo", "A".repeat(21));
}

assert {
  res.status: eq 400
}

tests {
  test("mensaje esperado", function () {
    expect(res.body.mensaje).to.include("Los datos de entrada no cumplen con las validaciones requeridas");
  });

  test("detalle del codigo", function () {
    expect(res.body.detalles).to.include("codigo: El código no puede superar los 20 caracteres");
  });

  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body).to.have.property("timestamp");
    expect(res.body).to.have.property("status");
    expect(res.body).to.have.property("error");
    expect(res.body).to.have.property("mensaje");
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
