meta {
  name: 05 Codigo y programa se ignoran
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/asignaturas/{{idBRU12}}
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Renombrada Bruno",
    "codigo": "OTRO",
    "programaId": "{{programaInactivoId}}"
  }
}

assert {
  res.status: eq 200
  res.body.codigo: eq BRU12
  res.body.programaId: eq {{programaActivoId}}
}
