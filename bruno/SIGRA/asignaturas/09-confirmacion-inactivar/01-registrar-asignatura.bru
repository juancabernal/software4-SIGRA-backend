meta {
  name: 01 Registrar asignatura para la prueba de confirmacion
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/asignaturas
  body: json
  auth: none
}

body:json {
  {
    "codigo": "{{codigoConf}}",
    "nombre": "Bruno Confirmacion Inactivar",
    "programaId": "{{programaActivoId}}"
  }
}

script:pre-request {
  bru.setVar("codigoConf", "bruconf" + Date.now());
}

assert {
  res.status: eq 201
  res.body.estado: eq BORRADOR
}

script:post-response {
  bru.setVar("confAsigId", res.body.id);
}
