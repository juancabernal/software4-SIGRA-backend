meta {
  name: 01 Preflight desde el frontend
  type: http
  seq: 1
}

options {
  url: {{baseUrl}}/api/v1/asignaturas
  body: none
  auth: none
}

headers {
  Origin: http://localhost:4200
  Access-Control-Request-Method: POST
}

assert {
  res.status: eq 200
}

tests {
  test("permite el origen del frontend", function () {
    expect(res.getHeader("access-control-allow-origin")).to.equal("http://localhost:4200");
  });
}
