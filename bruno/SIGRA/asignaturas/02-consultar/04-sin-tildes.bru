meta {
  name: 04 Sin tildes
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/asignaturas?texto=programacion bruno
  body: none
  auth: none
}

params:query {
  texto: programacion bruno
}

assert {
  res.status: eq 200
}

tests {
  test("responde un arreglo", function () {
    expect(res.body).to.be.an("array");
  });

  test("codigos esperados", function () {
    const codigos = res.body.map((a) => a.codigo);
    expect(codigos).to.include("BRU13");
  });
}
