meta {
  name: 02 Consultar por codigo
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/semestres/2090-1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("datos del semestre", function () {
    expect(res.body.codigo).to.equal("2090-1");
    expect(res.body.fechaInicio).to.equal("2090-01-20");
    expect(res.body.fechaFin).to.equal("2090-06-10");
    expect(res.body.estado).to.equal("INACTIVO");
  });
}
