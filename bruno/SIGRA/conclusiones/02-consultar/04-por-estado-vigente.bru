meta {
  name: 04 Por estado VIGENTE
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/conclusiones?estado=VIGENTE
  body: none
  auth: none
}

params:query {
  estado: VIGENTE
}

assert {
  res.status: eq 200
}

tests {
  test("solo trae conclusiones VIGENTE", function () {
    expect(res.body).to.be.an("array").with.length.at.least(1);
    res.body.forEach((c) => expect(c.estado).to.equal("VIGENTE"));
  });
}
