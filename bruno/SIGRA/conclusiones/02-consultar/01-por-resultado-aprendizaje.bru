meta {
  name: 01 Por resultado de aprendizaje
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/conclusiones?resultadoAprendizajeId={{raConcMas40Id}}
  body: none
  auth: none
}

params:query {
  resultadoAprendizajeId: {{raConcMas40Id}}
}

assert {
  res.status: eq 200
}

tests {
  test("solo trae conclusiones del RA pedido", function () {
    expect(res.body).to.be.an("array").with.length.at.least(1);
    res.body.forEach((c) => expect(c.resultadoAprendizajeId).to.equal(bru.getEnvVar("raConcMas40Id")));
  });
}
