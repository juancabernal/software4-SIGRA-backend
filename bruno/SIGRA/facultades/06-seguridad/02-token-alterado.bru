meta {
  name: 02 Token alterado
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/facultades
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer token-no-valido
}

body:json {
  {
    "nombre": "Facultad Bruno Token Alterado"
  }
}

assert {
  res.status: eq 401
  res.body.error: eq UNAUTHORIZED
}
