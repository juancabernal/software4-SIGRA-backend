meta {
  name: 02 Crear facultad de apoyo
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/facultades
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Facultad Bruno Apoyo {{sufijoApoyo}}"
  }
}

script:pre-request {
  bru.setVar("sufijoApoyo", String(Date.now()).slice(-7));
}

script:post-response {
  bru.setVar("facultadApoyoId", res.body.id);
  bru.setVar("facultadApoyoNombre", res.body.nombre);
}

assert {
  res.status: eq 201
}
