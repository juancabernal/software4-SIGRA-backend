meta {
  name: 01 Registrar programa en facultad inactiva
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/programas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Programa Bruno Facultad Inactiva {{sufijoProgFac}}",
    "codigo": "BRI{{sufijoProgFac}}",
    "facultadId": "{{facultadCreadaId}}"
  }
}

script:pre-request {
  bru.setVar("sufijoProgFac", String(Date.now()).slice(-7));
}

assert {
  res.status: eq 409
}

tests {
  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body.mensaje).to.include("inactiva");
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
