meta {
  name: 04 Inactivar facultad con ese programa activo
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/facultades/{{facultadApoyoId}}/inactivar
  body: none
  auth: none
}

assert {
  res.status: eq 409
}

tests {
  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body.mensaje).to.include("programas activos");
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
