meta {
  name: 04 Sin coincidencias
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/facultades?nombre=zzz-no-existe-{{sufijoFacultad}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("devuelve lista vacia", function () {
    expect(res.body).to.be.an("array").that.is.empty;
  });
}
