meta {
  name: 07 Id inexistente
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/facultades/{{idFacultadInexistente}}
  body: none
  auth: none
}

assert {
  res.status: eq 404
}

tests {
  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body.mensaje).to.include(bru.getEnvVar("idFacultadInexistente"));
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
