meta {
  name: 03 Nombre de otra facultad
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/facultades/{{facultadCreadaId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "{{facultadPorDefectoNombre}}"
  }
}

assert {
  res.status: eq 409
}

tests {
  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body.mensaje).to.include(bru.getEnvVar("facultadPorDefectoNombre"));
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
