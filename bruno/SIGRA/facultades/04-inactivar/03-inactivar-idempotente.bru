meta {
  name: 03 Inactivar idempotente
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/facultades/{{facultadCreadaId}}/inactivar
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("sigue INACTIVA sin error", function () {
    expect(res.body.estado).to.equal("INACTIVO");
  });
}
