meta {
  name: 01 Registrar facultad valida
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/facultades
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "  Facultad Bruno Ingeniería {{sufijoFacultad}}  "
  }
}

script:pre-request {
  bru.setVar("sufijoFacultad", String(Date.now()).slice(-7));
}

script:post-response {
  bru.setVar("facultadCreadaId", res.body.id);
  bru.setVar("facultadCreadaNombre", res.body.nombre);
}

assert {
  res.status: eq 201
}

tests {
  test("se guarda ACTIVA y sin espacios sobrantes", function () {
    expect(res.body.nombre).to.equal("Facultad Bruno Ingeniería " + bru.getVar("sufijoFacultad"));
    expect(res.body.estado).to.equal("ACTIVO");
  });

  test("devuelve el id generado", function () {
    expect(res.body.id).to.be.a("string").and.not.be.empty;
  });
}
