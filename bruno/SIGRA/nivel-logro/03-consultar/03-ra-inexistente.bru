meta {
  name: 03 RA inexistente 404
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/resultados-aprendizaje/{{idInexistente}}/semestres/{{semBruNivId}}/estadisticas
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.status: eq 404
}

tests {
  test("sin detalles tecnicos", function () {
    expect(JSON.stringify(res.body)).to.not.contain("Exception");
  });
}
