meta {
  name: 03 Registrar de nuevo sobre esa misma conclusion (ya no vigente)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/conclusiones/{{conclusionVigenteId}}/acciones-mejora
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Segundo intento",
    "descripcion": "No deberia poder registrarse porque la conclusion ya no esta vigente."
  }
}

assert {
  res.status: eq 400
}

tests {
  test("mensaje esperado", function () {
    expect(res.body.mensaje).to.include("no está en estado VIGENTE");
  });

  test("error con formato estandar y sin detalles tecnicos", function () {
    expect(res.body).to.have.property("timestamp");
    expect(res.body).to.have.property("status");
    expect(res.body).to.have.property("error");
    expect(res.body).to.have.property("mensaje");
    const texto = JSON.stringify(res.body);
    expect(texto).to.not.include("Exception");
    expect(texto).to.not.include("at co.edu");
  });
}
