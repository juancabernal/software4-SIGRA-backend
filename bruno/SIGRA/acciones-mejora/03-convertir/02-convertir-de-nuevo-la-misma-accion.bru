meta {
  name: 02 Convertir de nuevo esa misma accion
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/acciones-mejora/{{accionMejoraId}}/conversion
  body: json
  auth: none
}

body:json {
  {
    "porcentaje": 10
  }
}

assert {
  res.status: eq 409
}

tests {
  test("mensaje esperado", function () {
    expect(res.body.mensaje).to.include("ya fue convertida en evaluación");
  });
}
