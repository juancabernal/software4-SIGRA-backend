meta {
  name: 07 Porcentaje cero
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/acciones-mejora/{{accionMejoraId}}/conversion
  body: json
  auth: none
}

body:json {
  {
    "fechaTentativa": "{{fechaTentativaConversion}}",
    "porcentaje": 0
  }
}

assert {
  res.status: eq 400
}

tests {
  test("el detalle senala el campo porcentaje", function () {
    expect(res.body.detalles.some(function (d) { return d.startsWith("porcentaje:"); })).to.equal(true);
  });
}
