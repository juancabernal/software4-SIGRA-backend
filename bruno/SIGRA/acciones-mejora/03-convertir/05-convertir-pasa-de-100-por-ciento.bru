meta {
  name: 05 Convertir con un porcentaje que supera el 100 por ciento
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/acciones-mejora/{{accionMejora2Id}}/conversion
  body: json
  auth: none
}

body:json {
  {
    "porcentaje": 50
  }
}

docs {
  La primera accion de mejora (accionMejoraId) ya convirtio el 60% de este
  (RA, semestre) en "01 Convertir con un porcentaje valido". 60 + 50 = 110,
  por encima del 100%.
}

assert {
  res.status: eq 400
}

tests {
  test("mensaje esperado", function () {
    expect(res.body.mensaje).to.include("supera el límite permitido");
  });
}
