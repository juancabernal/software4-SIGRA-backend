meta {
  name: 05 Sin token responde 401
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/acciones-mejora/{{accionMejoraActualizarId}}
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Intento sin autenticar",
    "descripcion": "No deberia poder editarse sin un token."
  }
}

script:pre-request {
  req.deleteHeader("Authorization");
}

assert {
  res.status: eq 401
}

tests {
  test("mensaje esperado", function () {
    expect(res.body.mensaje).to.include("Debe iniciar sesión");
  });
}
